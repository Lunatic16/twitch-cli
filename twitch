#!/usr/bin/env python3
"""
Twitch CLI - Quick launch script
Usage: twitch <channel> [player]
"""

import subprocess
import sys
import os

# Get the directory where this script is located
script_dir = os.path.dirname(os.path.abspath(__file__))
main_script = os.path.join(script_dir, "twitch_cli.py")

# Run the main CLI with all arguments
sys.argv.insert(1, os.path.basename(sys.argv[0]))
result = subprocess.run([sys.executable, main_script] + sys.argv[1:])
sys.exit(result.returncode)
